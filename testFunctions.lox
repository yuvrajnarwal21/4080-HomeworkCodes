fun thrice(fn) {
  for (var i = 1; i <= 3; i = i + 1) {
    fn(i);
  }
}

thrice(fun(a) {
  print a;
});

// anonymous function on its own
fun () {};

// save one and call it
var doubleIt = fun(n) {
  return n * 2;
};
print doubleIt(4);

// returned function remembers amount
fun makeAdder(amount) {
  return fun(n) {
    return amount + n;
  };
}

var addFive = makeAdder(5);
print addFive(10);